# Copie para .env.local (dev) ou .env (servidor cPanel) e preencha.
# NUNCA commitar o arquivo preenchido. Permissao no servidor: chmod 600.
#
# Regra de ouro: qualquer variavel com prefixo VITE_ vai para dentro do bundle
# JavaScript e fica visivel para qualquer visitante do site. Chave de provedor
# de IA NUNCA leva prefixo VITE_.

# ── Supabase (publico por design, protegido por RLS) ─────────────────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Chaves de IA: server-side apenas, injetadas pelo proxy em server.js ───────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Autorizacao ──────────────────────────────────────────────────────────────
# Dominios corporativos liberados, separados por virgula. Precisa bater com
# ALLOWED_EMAIL_DOMAINS em front/src/lib/accessConfig.ts.
ALLOWED_EMAIL_DOMAINS=ddm.adv.br,grupoddm.com.br,grupoddm.ia.br

# E-mails que podem gerenciar a base de conhecimento (arquivos e vector stores
# da conta OpenAI da organizacao). Separados por virgula.
ADMIN_EMAILS=gisele.oliveira@ddm.adv.br

# ── Limites ──────────────────────────────────────────────────────────────────
# Chamadas de IA por usuario a cada 15 minutos.
AI_RATE_LIMIT=60
# Tamanho maximo de upload para a base de conhecimento, em bytes.
MAX_UPLOAD_BYTES=20971520

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
# Origens cross-origin liberadas (so precisa em dev com Vite em outra porta).
# Em producao deixe vazio: a app serve o proprio frontend, same-origin.
CORS_ORIGINS=

# Copie para .env.local (dev) ou .env (servidor cPanel) e preencha.
# NUNCA commitar o arquivo preenchido. Permissao no servidor: chmod 600.
#
# Regra de ouro: qualquer variavel com prefixo VITE_ vai para dentro do bundle
# JavaScript e fica visivel para qualquer visitante do site. Chave de provedor
# de IA ou segredo de banco NUNCA leva prefixo VITE_.

# ── MariaDB (cPanel: Bancos de Dados MySQL®) ─────────────────────────────────
# Nome do banco/usuario no cPanel costuma vir prefixado: cpaneluser_ddmlab.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=8

# ── Autenticacao (JWT proprio, substitui o Supabase Auth) ────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimo 32 caracteres. Trocar este valor invalida todas as sessoes ativas.
JWT_ACCESS_SECRET=
# Duracao do refresh token (dias) — quanto tempo o usuario fica logado sem
# precisar digitar a senha de novo.
REFRESH_TOKEN_DAYS=30

# ── E-mail (codigo de recuperacao de senha) ──────────────────────────────────
# Sem SMTP_HOST configurado, o codigo cai no log do servidor (util em dev,
# NUNCA deixar assim em producao). cPanel: Contas de E-mail > Configurar
# Cliente de E-mail costuma dar host/porta prontos para o dominio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@grupoddm.com.br

# ── Armazenamento de arquivos (substitui o Supabase Storage) ─────────────────
# Caminho relativo a front/ (raiz da app no cPanel). Fica FORA de dist/ e
# fora do docroot publico — os arquivos so saem por /api/files, autenticado.
STORAGE_DIR=../storage

# ── Chaves de IA: server-side apenas, injetadas pelo proxy em server.js ──────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Autorizacao ───────────────────────────────────────────────────────────────
# Dominios corporativos liberados, separados por virgula. Precisa bater com
# ALLOWED_EMAIL_DOMAINS em front/src/lib/accessConfig.ts.
ALLOWED_EMAIL_DOMAINS=ddm.adv.br,grupoddm.com.br,grupoddm.ia.br

# E-mails que podem gerenciar a base de conhecimento (arquivos e vector stores
# da conta OpenAI) e o painel Admin. Separados por virgula.
ADMIN_EMAILS=gisele.oliveira@ddm.adv.br

# E-mails de RH que nao estao em ALLOWED_EMAIL_DOMAINS (ex.: RH terceirizado).
# Normalmente vazio — o time de RH interno ja cai no dominio corporativo.
RH_EMAILS=

# ── Limites ────────────────────────────────────────────────────────────────
# Chamadas de IA por usuario a cada 15 minutos.
AI_RATE_LIMIT=60
# Tamanho maximo de upload (imagens, anexos de RH, base de conhecimento), em bytes.
MAX_UPLOAD_BYTES=20971520

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Origens cross-origin liberadas (so precisa em dev com Vite em outra porta).
# Em producao deixe vazio: a app serve o proprio frontend, same-origin.
CORS_ORIGINS=

# ── Migracao (usado so pelos scripts em backend/scripts/, nao pelo server) ──
# String de conexao Postgres DIRETA do Supabase (Project Settings > Database >
# Connection string > URI). Necessaria so para extrair auth.users com o hash
# de senha (a API REST/Admin do Supabase nao expoe encrypted_password).
SUPABASE_DB_URL=
# URL e chave do projeto Supabase (para ler as 19 tabelas via REST e baixar
# os arquivos do Storage). A service_role key ignora RLS — nunca vai no front.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
